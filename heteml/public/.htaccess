# PHP の動かし方によっては Authorization ヘッダーが PHP に渡らないため、環境変数に移して渡す（src/api.php）
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# ドットで始まるファイル（.htaccess など）は見せない
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

RewriteEngine On

# 正の URL は https://releasetune.com（2026-10-15 ユーザー決定。canonical・シェア文・カード画像の URL と同じ）。
# www 付きと http はすべてここへ恒久的に転送する。
# ※ https://www は証明書がないと転送の前に接続エラーになる（無料SSLの発行時に www が Vercel を向いていたため。ヘテムルに再発行を依頼中）
RewriteCond %{HTTP_HOST} ^www\.releasetune\.com$ [NC]
RewriteRule ^ https://releasetune.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^releasetune\.com$ [NC]
RewriteRule ^ https://releasetune.com%{REQUEST_URI} [R=301,L]

# 実在するファイル（assets/・api/）以外の URL はすべて index.php で振り分ける（Next.js 版と同じ URL）
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]

# セキュリティヘッダー（Next.js 版の next.config.ts と同じ。Supabase は使わなくなったので connect-src から外した）
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.mzstatic.com https://i.scdn.co https://img.youtube.com https://www.googletagmanager.com; frame-src https://www.youtube.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# CSS・JS はファイル名に更新日時を付けて読むので長くキャッシュしてよい
<FilesMatch "\.(css|js)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>
