{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "releasetune-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "heteml-php",
      "runtimeExecutable": "php",
